POSTGRES_USER=khachik
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=khachik

JWT_SECRET=replace-with-long-random-string
ADMIN_EMAIL=admin@khachikmedia.com
ADMIN_PASSWORD=replace-with-strong-password

AWS_REGION=ap-south-1
S3_BUCKET=khachik-media-assets
CLOUDFRONT_URL=https://dxxxxxxxxxxxx.cloudfront.net

# Prefer an EC2 instance role. Fill these only if not using a role:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Origins allowed to call the API (comma-separated)
CORS_ORIGINS=https://khachik-media.vercel.app,https://admin.yourdomain.com,http://localhost:5173,http://localhost:5174

# Public API URL baked into the admin SPA build
PUBLIC_API_URL=https://api.yourdomain.com

# Resend — contact form inquiries
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=contact@khachikmedia.com
CONTACT_FROM_EMAIL=Khachik Media <noreply@khachikmedia.com>
