{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MediaBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::khachik-media-assets/*"
    },
    {
      "Sid": "MediaBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::khachik-media-assets"
    }
  ]
}
